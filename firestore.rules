rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Catálogo y contenido público (solo lectura)
    match /products/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /sucursales/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /blog_posts/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Cupones: nunca legibles por clientes (solo Cloud Functions)
    match /coupons/{code} {
      allow read, write: if false;
    }

    // Contador de pedidos: solo servidor
    match /counters/{id} {
      allow read, write: if false;
    }

    // Perfil de usuario: lo crea el servidor. El cliente solo edita datos de contacto.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, delete: if false;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nombre_completo', 'telefono', 'direccion'])
        && request.resource.data.nombre_completo is string
        && request.resource.data.nombre_completo.size() > 0
        && request.resource.data.nombre_completo.size() <= 100
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() <= 30
        && request.resource.data.direccion is string
        && request.resource.data.direccion.size() <= 200;

      // Lista de deseos propia
      match /wishlist/{productId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && productId.matches('^[0-9]{1,6}$')
          && request.resource.data.keys().hasOnly(['producto_id', 'created_at'])
          && request.resource.data.producto_id is int;
        allow delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // Pedidos: lectura propia (o admin). Escritura solo desde Cloud Functions.
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.usuario_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Todo lo demás: denegado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
